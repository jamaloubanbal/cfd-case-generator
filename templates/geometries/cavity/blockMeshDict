FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Geometry: square cavity (natural convection)
//   hotWall  : left face  (x = 0)
//   coldWall : right face (x = domain_x)
//   top      : top face   (y = domain_y)
//   bottom   : bottom face (y = 0)
//   frontAndBack : empty (2-D)

scale   1;

vertices
(
    (0              0               0)              // 0
    ({{ domain_x }} 0               0)              // 1
    ({{ domain_x }} {{ domain_y }}  0)              // 2
    (0              {{ domain_y }}  0)              // 3
    (0              0               {{ domain_z }}) // 4
    ({{ domain_x }} 0               {{ domain_z }}) // 5
    ({{ domain_x }} {{ domain_y }}  {{ domain_z }}) // 6
    (0              {{ domain_y }}  {{ domain_z }}) // 7
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ({{ nx }} {{ ny }} 1) simpleGrading ({{ grading_x_both }} 1 1)
);

edges
(
);

boundary
(
    hotWall
    {
        type wall;
        faces ( (0 4 7 3) );
    }

    coldWall
    {
        type wall;
        faces ( (1 2 6 5) );
    }

    top
    {
        type wall;
        faces ( (3 7 6 2) );
    }

    bottom
    {
        type wall;
        faces ( (0 1 5 4) );
    }

    frontAndBack
    {
        type empty;
        faces
        (
            (0 3 2 1)
            (4 5 6 7)
        );
    }
);

