FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Geometry: free-surface basin (interFoam / dam-break)
//   inlet      : left face  (x = 0)
//   outlet     : right face (x = domain_x)
//   walls      : bottom face (y = 0)
//   atmosphere : top face    (y = domain_y) — open to air
//   frontAndBack : empty (2-D)

scale   1;

vertices
(
    (0              0               0)              // 0
    ({{ domain_x }} 0               0)              // 1
    ({{ domain_x }} {{ domain_y }}  0)              // 2
    (0              {{ domain_y }}  0)              // 3
    (0              0               {{ domain_z }}) // 4
    ({{ domain_x }} 0               {{ domain_z }}) // 5
    ({{ domain_x }} {{ domain_y }}  {{ domain_z }}) // 6
    (0              {{ domain_y }}  {{ domain_z }}) // 7
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ({{ nx }} {{ ny }} 1) simpleGrading (1 {{ grading_y_floor }} 1)
);

edges
(
);

boundary
(
    inlet
    {
        type patch;
        faces ( (0 4 7 3) );
    }

    outlet
    {
        type patch;
        faces ( (1 2 6 5) );
    }

    walls
    {
        type wall;
        faces ( (0 1 5 4) );
    }

    atmosphere
    {
        type patch;
        faces ( (3 7 6 2) );
    }

    frontAndBack
    {
        type empty;
        faces
        (
            (0 3 2 1)
            (4 5 6 7)
        );
    }
);

