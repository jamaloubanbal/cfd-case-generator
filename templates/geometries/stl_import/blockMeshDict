FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Background mesh bounding box for snappyHexMesh.
// Bounds are computed from the uploaded STL + expansion factors.
// snappyHexMesh will refine this coarse background mesh around the geometry.

convertToMeters 1;

vertices
(
    ( {{ bg_xmin }} {{ bg_ymin }} {{ bg_zmin }} )  // 0
    ( {{ bg_xmax }} {{ bg_ymin }} {{ bg_zmin }} )  // 1
    ( {{ bg_xmax }} {{ bg_ymax }} {{ bg_zmin }} )  // 2
    ( {{ bg_xmin }} {{ bg_ymax }} {{ bg_zmin }} )  // 3
    ( {{ bg_xmin }} {{ bg_ymin }} {{ bg_zmax }} )  // 4
    ( {{ bg_xmax }} {{ bg_ymin }} {{ bg_zmax }} )  // 5
    ( {{ bg_xmax }} {{ bg_ymax }} {{ bg_zmax }} )  // 6
    ( {{ bg_xmin }} {{ bg_ymax }} {{ bg_zmax }} )  // 7
);

blocks
(
    // x: streamwise  y: cross-stream  z: spanwise
    hex (0 1 2 3 4 5 6 7)
    ( {{ bg_nx }} {{ bg_ny }} {{ bg_nz }} )
    simpleGrading (1 1 1)
);

edges ();

boundary
(
    inlet
    {
        type patch;
        faces ( (0 4 7 3) );        // x = bg_xmin  (outward normal: -x)
    }
    outlet
    {
        type patch;
        faces ( (1 2 6 5) );        // x = bg_xmax  (outward normal: +x)
    }
    bottom
    {
        type symmetry;
        faces ( (0 1 5 4) );        // y = bg_ymin  (outward normal: -y)
    }
    top
    {
        type symmetry;
        faces ( (2 3 7 6) );        // y = bg_ymax  (outward normal: +y)
    }
    front
    {
        type symmetry;
        faces ( (0 3 2 1) );        // z = bg_zmin  (outward normal: -z)
    }
    back
    {
        type symmetry;
        faces ( (4 5 6 7) );        // z = bg_zmax  (outward normal: +z)
    }
);

