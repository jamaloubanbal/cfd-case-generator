FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

numberOfSubdomains  {{ n_cores }};

// "hierarchical" is built into every OpenFOAM installation, whereas "scotch"
// needs the optional libscotch (absent from e.g. the Debian/Ubuntu package).
// The {{ n_cores }} subdomains are split along x first (the streamwise direction).
method          hierarchical;

coeffs
{
    n           ({{ decomp_n[0] }} {{ decomp_n[1] }} {{ decomp_n[2] }});
    order       xyz;
}

