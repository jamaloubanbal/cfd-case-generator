#!/bin/sh
cd "${0%/*}" || exit 1

# Use the official OpenFOAM helper when available, otherwise remove the
# usual run artefacts by hand (time directories, mesh, logs, processors).
if [ -n "$WM_PROJECT_DIR" ] && [ -f "$WM_PROJECT_DIR/bin/tools/CleanFunctions" ]; then
    . "$WM_PROJECT_DIR/bin/tools/CleanFunctions"
    cleanCase
else
    for d in [1-9]* 0.[0-9]*; do
        [ -d "$d" ] && rm -rf "$d"
    done
    rm -rf constant/polyMesh constant/extendedFeatureEdgeMesh processor* \
           postProcessing log.* constant/triSurface/*.eMesh
fi
