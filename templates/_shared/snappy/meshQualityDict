FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      meshQualityDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Mesh quality thresholds used by snappyHexMesh (referenced via #include).
// These are conservative defaults; loosen if snappy struggles to converge.

maxNonOrtho         65;
maxBoundarySkewness 20;
maxInternalSkewness 4;
maxConcave          80;
minFlatness         0.5;
minVol              1e-13;
minTetQuality       1e-15;
minArea             -1;
minTwist            0.01;
minDeterminant      0.001;
minFaceWeight       0.05;
minVolRatio         0.01;
minTriangleTwist    -1;

