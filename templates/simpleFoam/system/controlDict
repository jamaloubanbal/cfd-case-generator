FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         1000;

deltaT          1;

writeControl    timeStep;

writeInterval   100;

purgeWrite      3;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable true;

// NOTE (OpenFOAM v1912): function objects crash on startup due to a SHA1
// IOstream bug in this version.  Residuals are printed to stdout instead.
// To extract them after running:
//   simpleFoam 2>&1 | tee simpleFoam.log
//   foamLog simpleFoam.log        <- creates logs/p_0, logs/Ux_0, etc.

