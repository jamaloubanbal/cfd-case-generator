FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   1;

// Basin: {{ domain_x }} m long x {{ domain_y }} m tall x {{ domain_z }} m deep
// Cells: {{ nx }} x {{ ny }} x {{ nz }}

vertices
(
    (0              0              0)
    ({{ domain_x }} 0              0)
    ({{ domain_x }} {{ domain_y }} 0)
    (0              {{ domain_y }} 0)
    (0              0              {{ domain_z }})
    ({{ domain_x }} 0              {{ domain_z }})
    ({{ domain_x }} {{ domain_y }} {{ domain_z }})
    (0              {{ domain_y }} {{ domain_z }})
);

blocks
(
    hex (0 1 2 3 4 5 6 7)
    ({{ nx }} {{ ny }} {{ nz }})
    simpleGrading (1 1 1)
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (0 4 7 3)
        );
    }

    outlet
    {
        type patch;
        faces
        (
            (1 2 6 5)
        );
    }

    walls
    {
        type wall;
        faces
        (
            (0 1 5 4)
        );
    }

    atmosphere
    {
        type patch;
        faces
        (
            (3 7 6 2)
        );
    }

    frontAndBack
    {
        type empty;
        faces
        (
            (0 3 2 1)
            (4 5 6 7)
        );
    }
);

