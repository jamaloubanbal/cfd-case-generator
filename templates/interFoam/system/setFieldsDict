FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Set alpha.water = 0 everywhere first, then 1 inside the water column box.

defaultFieldValues
(
    volScalarFieldValue alpha.water 0
);

regions
(
    boxToCell
    {
        // Initial water column: left {{ "%.4g" | format(x_water / domain_x * 100) }}% of domain × lower {{ "%.4g" | format(y_water / domain_y * 100) }}% of domain
        box (0 0 0) ({{ x_water }} {{ y_water }} {{ domain_z }});
        fieldValues
        (
            volScalarFieldValue alpha.water 1
        );
    }
);

