{# ── nut (turbulent kinematic viscosity) ─────────────────────────────────── #}
{# turb_model: 'kEpsilon' | 'kOmegaSST' | 'SpalartAllmaras'                  #}
{% macro nut_boundary(patches, turb_model='kEpsilon') %}
boundaryField
{
{% for p in patches %}
    {{ p.name }}
    {
{%- if p.of_type == 'empty' %}
        type            empty;
{%- elif p.of_type == 'wedge' %}
        type            wedge;
{%- elif p.role in ('inlet', 'outlet', 'atmosphere') %}
        type            calculated;
        value           uniform 0;
{%- elif p.role in ('wall', 'obstacle', 'hot_wall', 'cold_wall') %}
{%- if turb_model == 'SpalartAllmaras' %}
        type            nutUSpaldingWallFunction;
{%- else %}
        type            nutkWallFunction;
{%- endif %}
        value           uniform 0;
{%- elif p.role == 'symmetry' %}
        type            symmetryPlane;
{%- endif %}
    }
{% endfor %}
}
{% endmacro %}

