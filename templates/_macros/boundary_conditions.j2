{# ── alphat (turbulent thermal diffusivity, compressible) ────────────────── #}
{% macro alphat_boundary(patches) %}
boundaryField
{
{% for p in patches %}
    {{ p.name }}
    {
{%- if p.of_type == 'empty' %}
        type            empty;
{%- elif p.of_type == 'wedge' %}
        type            wedge;
{%- elif p.role in ('inlet', 'outlet') %}
        type            calculated;
        value           uniform 0;
{%- elif p.role in ('wall', 'obstacle', 'hot_wall', 'cold_wall') %}
        type            compressible::alphatWallFunction;
        Prt             0.85;
        value           uniform 0;
{%- elif p.role == 'symmetry' %}
        type            symmetryPlane;
{%- endif %}
    }
{% endfor %}
}
{% endmacro %}

{# ── T buoyant (temperature for buoyantSimpleFoam) ───────────────────────── #}
{% macro T_buoyant_boundary(patches, T_hot, T_cold, T_initial) %}
boundaryField
{
{% for p in patches %}
    {{ p.name }}
    {
{%- if p.of_type == 'empty' %}
        type            empty;
{%- elif p.of_type == 'wedge' %}
        type            wedge;
{%- elif p.role == 'hot_wall' %}
        type            fixedValue;
        value           uniform {{ T_hot }};
{%- elif p.role == 'cold_wall' %}
        type            fixedValue;
        value           uniform {{ T_cold }};
{%- elif p.role in ('wall', 'obstacle') %}
        type            zeroGradient;
{%- elif p.role == 'inlet' %}
        type            fixedValue;
        value           uniform {{ T_initial }};
{%- elif p.role == 'outlet' %}
        type            zeroGradient;
{%- elif p.role == 'symmetry' %}
        type            symmetryPlane;
{%- endif %}
    }
{% endfor %}
}
{% endmacro %}

