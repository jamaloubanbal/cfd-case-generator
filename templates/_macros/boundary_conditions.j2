{# ── p compressible (absolute pressure, Pa) ──────────────────────────────── #}
{% macro p_compressible_boundary(patches, p_outlet) %}
boundaryField
{
{% for p in patches %}
    {{ p.name }}
    {
{%- if p.of_type == 'empty' %}
