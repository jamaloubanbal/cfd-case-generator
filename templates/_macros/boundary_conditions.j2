{#
  Shared Jinja2 macros for OpenFOAM boundary field rendering.

  Each macro receives a `patches` list (from GEOMETRY_PATCHES in base.py),
  where every patch dict has: name, of_type, role.

  Roles understood:
    inlet       — velocity inlet
    outlet      — pressure outlet
    wall        — generic no-slip wall
    obstacle    — obstacle surface (treated as wall)
    hot_wall    — heated wall (buoyantSimpleFoam)
    cold_wall   — cooled wall (buoyantSimpleFoam)
    atmosphere  — free-surface atmosphere (interFoam)
    symmetry    — symmetry plane
    frontAndBack — 2-D empty patch
#}

{# ── U (velocity) ────────────────────────────────────────────────────────── #}
{% macro U_boundary(patches, inlet_U, outlet_type='zeroGradient') %}
boundaryField
{
{% for p in patches %}
    {{ p.name }}
    {
{%- if p.of_type == 'empty' %}
        type            empty;
{%- elif p.of_type == 'wedge' %}
        type            wedge;
{%- elif p.role == 'inlet' %}
        type            fixedValue;
        value           uniform {{ inlet_U }};
{%- elif p.role == 'outlet' %}
{%- if outlet_type == 'inletOutlet' %}
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform {{ inlet_U }};
{%- else %}
        type            zeroGradient;
{%- endif %}
{%- elif p.role in ('wall', 'obstacle', 'hot_wall', 'cold_wall') %}
        type            noSlip;
{%- elif p.role == 'atmosphere' %}
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
{%- elif p.role == 'symmetry' %}
        type            symmetryPlane;
{%- endif %}
    }
{% endfor %}
}
{% endmacro %}

{# ── p incompressible (relative, [0 2 -2]) ───────────────────────────────── #}
{% macro p_incompressible_boundary(patches) %}
boundaryField
{
{% for p in patches %}
    {{ p.name }}
    {
{%- if p.of_type == 'empty' %}
        type            empty;
{%- elif p.of_type == 'wedge' %}
        type            wedge;
{%- elif p.role in ('inlet', 'wall', 'obstacle', 'hot_wall', 'cold_wall') %}
        type            zeroGradient;
{%- elif p.role == 'outlet' %}
        type            fixedValue;
        value           uniform 0;
{%- elif p.role == 'atmosphere' %}
        type            totalPressure;
        p0              uniform 0;
{%- elif p.role == 'symmetry' %}
        type            symmetryPlane;
{%- endif %}
    }
{% endfor %}
}
{% endmacro %}

