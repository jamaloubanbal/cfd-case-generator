FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform {{ p_ref }};

boundaryField
{
{% for p in patches %}
    {{ p.name }}
    {
{%- if p.of_type == 'empty' %}
        type            empty;
{%- elif p.role in ('inlet', 'wall', 'obstacle', 'hot_wall', 'cold_wall') %}
        type            fixedFluxPressure;
        value           uniform {{ p_ref }};
{%- elif p.role == 'outlet' %}
        type            fixedValue;
        value           uniform {{ p_ref }};
{%- elif p.role == 'atmosphere' %}
        type            totalPressure;
        p0              uniform {{ p_ref }};
{%- elif p.role == 'symmetry' %}
        type            symmetryPlane;
{%- endif %}
    }
{% endfor %}
}

