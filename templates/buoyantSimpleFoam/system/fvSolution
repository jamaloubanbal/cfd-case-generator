FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    // p_rgh is an absolute pressure (~1e5 Pa): an absolute tolerance of 1e-8
    // is below round-off, so GAMG would hit maxIter (1000) on every solve.
    p_rgh
    {
        solver          GAMG;
        tolerance       1e-06;
        relTol          0.01;
        smoother        DICGaussSeidel;
    }

    U
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-08;
        relTol          0.1;
    }

    T
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-08;
        relTol          0.1;
    }

    h
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-08;
        relTol          0.1;
    }

    e
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-08;
        relTol          0.1;
    }

{% if turb_model in ('kEpsilon', 'kOmegaSST') %}
    k
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-08;
        relTol          0.1;
    }

{% endif %}
{% if turb_model == 'kEpsilon' %}
    epsilon
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-08;
        relTol          0.1;
    }
{% elif turb_model == 'kOmegaSST' %}
    omega
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-08;
        relTol          0.1;
    }
{% elif turb_model == 'SpalartAllmaras' %}
    nuTilda
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-08;
        relTol          0.1;
    }
{% endif %}
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;   // the cavity block mesh is orthogonal
    momentumPredictor        no;
    pRefCell        0;
    pRefValue       0;
    residualControl
    {
        p_rgh           1e-5;
        U               1e-5;
        T               1e-5;
        h               1e-5;
{% if turb_model in ('kEpsilon', 'kOmegaSST') %}
        k               1e-5;
{% endif %}
{% if turb_model == 'kEpsilon' %}
        epsilon         1e-5;
{% elif turb_model == 'kOmegaSST' %}
        omega           1e-5;
{% elif turb_model == 'SpalartAllmaras' %}
        nuTilda         1e-5;
{% endif %}
    }
}

// Relaxation as in the buoyantCavity tutorial: SIMPLEC with weak relaxation
// diverged for laminar and high-Ra cases.
relaxationFactors
{
    fields
    {
        p_rgh           0.7;
        rho             1.0;
    }
    equations
    {
        U               0.3;
        T               0.3;
        h               0.3;
{% if turb_model in ('kEpsilon', 'kOmegaSST') %}
        k               0.7;
{% endif %}
{% if turb_model == 'kEpsilon' %}
        epsilon         0.7;
{% elif turb_model == 'kOmegaSST' %}
        omega           0.7;
{% elif turb_model == 'SpalartAllmaras' %}
        nuTilda         0.7;
{% endif %}
    }
}

