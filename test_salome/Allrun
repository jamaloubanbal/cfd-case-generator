#!/bin/sh
cd "${0%/*}" || exit 1

# Use the official OpenFOAM helpers when available.  Some distribution
# packages (e.g. Debian/Ubuntu "openfoam") do not ship bin/tools/RunFunctions,
# so fall back to minimal equivalents that write log.<application> files.
if [ -n "$WM_PROJECT_DIR" ] && [ -f "$WM_PROJECT_DIR/bin/tools/RunFunctions" ]; then
    . "$WM_PROJECT_DIR/bin/tools/RunFunctions"
else
    runApplication() {
        app="$1"
        if [ -f "log.$app" ]; then
            echo "$app already run: remove log.$app to re-run"
            return 0
        fi
        echo "Running $app on $PWD"
        "$@" > "log.$app" 2>&1 || { echo "$app failed — see log.$app"; exit 1; }
    }

fi

runApplication simpleFoam

