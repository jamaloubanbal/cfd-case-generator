FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 4.312417e-03;


boundaryField
{

    entree
    {
        type            fixedValue;
        value           uniform 4.312417e-03;
    }

    sortie
    {
        type            zeroGradient;
    }

    parois
    {
        type            epsilonWallFunction;
        value           uniform 4.312417e-03;
    }

}

