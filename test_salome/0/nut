FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;


boundaryField
{

    entree
    {
        type            calculated;
        value           uniform 0;
    }

    sortie
    {
        type            calculated;
        value           uniform 0;
    }

    parois
    {
        type            nutkWallFunction;
        value           uniform 0;
    }

}

