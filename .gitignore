# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Local tool config
.claude/settings.local.json
.qodo/

# Editors / OS
.vscode/
.idea/
.DS_Store

# OpenFOAM run artefacts when a case is run in the repo root. Anchored with '/' so
# they never match templates/ (templates/_shared/postProcessing/ must be tracked).
/log.*
/processor*/
/postProcessing/

# Cases generated inside the repo (e.g. cfdgen ... -o test/)
/test/
/test_*/
